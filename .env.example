# Copy to server/.env  (cp .env.example server/.env) and fill in real values.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Local PostgreSQL. `docker compose up -d db` starts one that matches this URL.
DATABASE_URL=postgresql://messmate:messmate_local@localhost:5432/messmate?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API (comma separated).
CLIENT_URL=http://localhost:5173
# Public base URL embedded in check-in QR codes (usually the client URL).
PUBLIC_APP_URL=http://localhost:5173

# Image uploads (local disk by default; swap for S3/R2 in production).
UPLOAD_DIR=uploads

# A student must be within this many metres of the mess for a QR check-in to count as verified.
CHECKIN_MAX_DISTANCE_M=300

# ---- Seed script only (npm run db:seed) ----
# Leave blank and the seed generates random passwords and prints them once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
